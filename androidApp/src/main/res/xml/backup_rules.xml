<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下自动备份规则（和 data_extraction_rules.xml 两段写的一样，BackupRulesTest 核对）。
  参与备份：Room 库 databases/trackr.db、设置 datastore/trackr_settings.preferences_pb、旧 SharedPreferences（除 Key 文件）。
  排除：高德 Key（新旧两个文件）、追踪会话。本机存储开关的代数随备份恢复，避免恢复后整表重新导入。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="trackr_amap_keys.xml" />
    <exclude domain="file" path="datastore/trackr_amap_keys.preferences_pb" />
    <exclude domain="file" path="datastore/tracking_session.json" />
    <exclude domain="file" path="store_switch" />
</full-backup-content>
